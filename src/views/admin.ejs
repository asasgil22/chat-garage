<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Painel Admin - Chat Garage (Apple Style)</title>
  <link rel="icon" href="/img/logo.jpg" type="image/jpeg">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    body {
      background-color: #000000;
      color: #f5f5f7;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Segoe UI", Roboto, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 20px 10px 0 10px;
      background-image: radial-gradient(circle at 50% -20%, #1c1c1e 0%, #000000 70%);
    }
    
    header {
      display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;
      padding: 14px 18px; background: rgba(28, 28, 30, 0.75); backdrop-filter: blur(25px);
      -webkit-backdrop-filter: blur(25px); border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px; max-width: 1350px; margin-left: auto; margin-right: auto;
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.5); flex-wrap: wrap; gap: 14px; width: 100%;
    }

    .admin-brand-container { display: flex; align-items: center; gap: 12px; }
    .admin-header-logo {
      width: 42px; height: 42px; border-radius: 50%;
      border: 1.5px solid rgba(245, 158, 11, 0.6); object-fit: cover;
      box-shadow: 0 0 15px rgba(245, 158, 11, 0.25);
    }
    .admin-title { font-size: 16px; font-weight: 700; color: #ffffff; letter-spacing: -0.3px; }
    .admin-subtitle { font-size: 11px; color: #86868b; }

    .header-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; width: 100%; justify-content: space-between; }
    @media(min-width: 768px) {
      .header-actions { width: auto; justify-content: flex-end; }
    }

    .switch-container {
      display: flex; align-items: center; gap: 8px;
      background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.08);
      padding: 6px 12px; border-radius: 12px;
    }
    .switch-label { font-size: 11px; font-weight: 600; text-transform: uppercase; color: #86868b; letter-spacing: 0.5px; }
    .switch { position: relative; display: inline-block; width: 38px; height: 22px; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .slider { position: absolute; cursor: pointer; inset: 0; background-color: #3a3a3c; transition: 0.3s; border-radius: 22px; }
    .slider:before { position: absolute; content: ""; height: 16px; width: 16px; left: 3px; bottom: 3px; background-color: white; transition: 0.3s; border-radius: 50%; }
    input:checked + .slider { background-color: #34c759; }
    input:checked + .slider:before { transform: translateX(16px); }

    .btn-header-action {
      background: rgba(255, 255, 255, 0.08); color: #ffffff; font-size: 11px; font-weight: 600;
      padding: 8px 12px; border-radius: 10px; text-decoration: none;
      display: flex; align-items: center; gap: 6px; border: 1px solid rgba(255, 255, 255, 0.08);
      transition: all 0.2s; cursor: pointer;
    }
    .btn-export { background: rgba(52, 199, 89, 0.2); color: #34c759; border-color: rgba(52, 199, 89, 0.3); }
    .btn-logout { color: #ff453a; border-color: rgba(255, 69, 58, 0.2); }

    /* Dashboard Grid */
    .dashboard-grid {
      max-width: 1350px; margin: 0 auto 20px auto;
      display: grid; grid-template-columns: 1fr; gap: 14px; width: 100%;
    }
    @media(min-width: 768px) {
      .dashboard-grid { grid-template-columns: 1fr 2fr 1.2fr; gap: 16px; }
    }

    .stats-column { display: flex; flex-direction: column; gap: 12px; }
    .stat-card {
      background: rgba(28, 28, 30, 0.6); backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px;
      padding: 16px; display: flex; flex-direction: column; box-shadow: 0 8px 20px rgba(0,0,0,0.3);
    }
    .stat-label { font-size: 11px; text-transform: uppercase; color: #86868b; font-weight: 600; }
    .stat-value { font-size: 24px; font-weight: 700; color: #f5f5f7; margin-top: 4px; }

    .charts-column { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    @media(max-width: 480px) {
      .charts-column { grid-template-columns: 1fr; }
    }
    .chart-card {
      background: rgba(28, 28, 30, 0.6); backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px;
      padding: 14px; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 160px;
    }
    .chart-title { font-size: 11px; font-weight: 600; text-transform: uppercase; color: #86868b; margin-bottom: 6px; align-self: flex-start; }

    /* Timeline Widget */
    .timeline-card {
      background: rgba(28, 28, 30, 0.6); backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px;
      padding: 16px; display: flex; flex-direction: column; height: 160px; overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }
    .timeline-item { font-size: 11px; color: #d1d1d6; padding: 6px 0; border-bottom: 1px solid rgba(255,255,255,0.04); display: flex; flex-direction: column; }
    .timeline-time { color: #86868b; font-size: 9px; }

    main { max-width: 1350px; margin: 0 auto; width: 100%; flex: 1; }

    /* Tabela & Ferramentas em Massa */
    .table-container {
      background: rgba(28, 28, 30, 0.6); backdrop-filter: blur(25px);
      border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px;
      overflow: hidden; box-shadow: 0 15px 30px rgba(0, 0, 0, 0.4); margin-bottom: 24px;
    }

    .table-header-box {
      padding: 14px 16px; background: rgba(28, 28, 30, 0.3);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;
    }

    .bulk-actions-bar {
      display: none; align-items: center; gap: 8px; background: rgba(10, 132, 255, 0.15);
      border: 1px solid rgba(10, 132, 255, 0.3); padding: 6px 12px; border-radius: 10px;
    }
    .bulk-actions-bar.visible { display: flex; flex-wrap: wrap; }

    .segmented-control { display: flex; background: rgba(0, 0, 0, 0.4); padding: 3px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.06); }
    .btn-segment { background: transparent; border: none; color: #86868b; font-size: 11px; font-weight: 600; padding: 6px 10px; border-radius: 8px; cursor: pointer; }
    .btn-segment.active { background: rgba(255, 255, 255, 0.12); color: #ffffff; }

    .search-input {
      background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 10px; padding: 8px 12px; color: #fff; font-size: 14px; width: 100%; outline: none;
    }
    @media(min-width: 768px) {
      .search-input { width: 220px; }
    }
    .search-input:focus { border-color: #0a84ff; box-shadow: 0 0 0 3px rgba(10, 132, 255, 0.2); }

    /* Wrapper com altura máxima e rolagem vertical/horizontal suave */
    .table-responsive-wrapper {
      width: 100%;
      max-height: 520px;          /* Altura máxima da tabela na tela */
      overflow-y: auto;          /* Adiciona scroll vertical para não cortar NADA */
      overflow-x: auto;          /* Adiciona scroll horizontal para telas menores */
      -webkit-overflow-scrolling: touch;
    }

    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 12px; white-space: nowrap; }
    
    /* Cabeçalho Fixo (Sticky) ao rolar a tabela verticalmente */
    th { 
      background: #1c1c1e; 
      position: sticky; 
      top: 0; 
      z-index: 5; 
      color: #86868b; 
      text-transform: uppercase; 
      font-size: 10px; 
      font-weight: 600; 
      padding: 12px 14px; 
      border-bottom: 1px solid rgba(255, 255, 255, 0.08); 
    }
    
    td { padding: 12px 14px; border-bottom: 1px solid rgba(255, 255, 255, 0.04); color: #d1d1d6; }
    tr:hover td { background: rgba(255, 255, 255, 0.02); }

    .status-badge {
      display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px;
      border-radius: 20px; font-size: 11px; font-weight: 600; cursor: pointer; border: none;
    }
    .badge-enviado { background: rgba(52, 199, 89, 0.15); color: #34c759; border: 1px solid rgba(52, 199, 89, 0.3); }
    .badge-enviado .led { width: 6px; height: 6px; background: #34c759; border-radius: 50%; box-shadow: 0 0 8px #34c759; }
    .badge-pendente { background: rgba(255, 69, 58, 0.15); color: #ff453a; border: 1px solid rgba(255, 69, 58, 0.3); }
    .badge-pendente .led { width: 6px; height: 6px; background: #ff453a; border-radius: 50%; box-shadow: 0 0 8px #ff453a; }

    .action-btns { display: flex; gap: 6px; }
    .btn-action { padding: 6px 10px; border-radius: 8px; font-size: 11px; font-weight: 600; cursor: pointer; border: none; text-transform: uppercase; }
    .btn-edit { background: rgba(10, 132, 255, 0.15); color: #0a84ff; border: 1px solid rgba(10, 132, 255, 0.3); }
    .btn-copy { background: rgba(191, 90, 242, 0.15); color: #bf5af2; border: 1px solid rgba(191, 90, 242, 0.3); }
    .btn-delete { background: rgba(255, 69, 58, 0.15); color: #ff453a; border: 1px solid rgba(255, 69, 58, 0.3); }

    /* Toast */
    #toast-container { position: fixed; bottom: 20px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 10px; max-width: 90vw; }
    .toast {
      background: rgba(30, 30, 32, 0.9); backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.12); color: #fff; padding: 12px 16px;
      border-radius: 12px; font-size: 12px; font-weight: 500; box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      display: flex; align-items: center; gap: 8px; animation: appleSlideIn 0.35s cubic-bezier(0.25, 1, 0.5, 1), fadeOut 0.3s ease 2.7s forwards;
    }
    @keyframes appleSlideIn { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    @keyframes fadeOut { to { opacity: 0; transform: translateY(10px); } }

    /* Modal */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(15px); z-index: 100; align-items: center; justify-content: center; padding: 12px; }
    .modal-content { background: rgba(28, 28, 30, 0.9); backdrop-filter: blur(30px); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 20px; width: 100%; max-width: 500px; padding: 24px; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.7); max-height: 90vh; overflow-y: auto; }
    .modal-title { font-size: 16px; font-weight: 700; color: #fff; margin-bottom: 16px; }
    .form-group { margin-bottom: 12px; }
    .form-group label { display: block; font-size: 11px; text-transform: uppercase; color: #86868b; font-weight: 600; margin-bottom: 4px; }
    .form-group input, .form-group select { width: 100%; background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 10px; padding: 10px; color: #fff; font-size: 16px; outline: none; }
    .modal-actions { display: flex; gap: 10px; margin-top: 20px; }
    .btn-save { flex: 1; background: #0a84ff; color: #fff; font-weight: 600; padding: 12px; border-radius: 10px; border: none; }
    .btn-cancel { flex: 1; background: rgba(255, 255, 255, 0.08); color: #fff; font-weight: 600; padding: 12px; border-radius: 10px; border: none; }

    /* Rodapé Modernizado com Badge Pill */
    footer { 
      background: rgba(28, 28, 30, 0.65); backdrop-filter: blur(25px); -webkit-backdrop-filter: blur(25px); 
      border-top: 1px solid rgba(255, 255, 255, 0.08); padding: 16px 20px; text-align: center; 
      font-size: 12px; color: #86868b; width: 100%; position: relative; z-index: 10; 
      margin-top: 30px; display: flex; align-items: center; justify-content: center; gap: 6px; flex-wrap: wrap; line-height: 1.6;
    }
    
    .dev-badge {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.12);
      padding: 2px 10px;
      border-radius: 12px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.25s cubic-bezier(0.25, 1, 0.5, 1);
      display: inline-flex;
      align-items: center;
    }
    .dev-badge:hover {
      background: rgba(245, 158, 11, 0.15);
      border-color: rgba(245, 158, 11, 0.4);
      color: #f59e0b;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.2);
    }
  </style>
</head>
<body>

  <div id="toast-container"></div>

  <header>
    <div class="admin-brand-container">
      <img src="/img/logo.jpg" alt="Logo" class="admin-header-logo" onerror="this.style.display='none'">
      <div>
        <div class="admin-title">Painel Chat Garage</div>
        <div class="admin-subtitle">Admin: <strong><%= user %></strong></div>
      </div>
    </div>

    <div class="header-actions">
      <div class="switch-container">
        <span class="switch-label">Cadastros</span>
        <label class="switch">
          <input type="checkbox" id="travaSwitch" <%= config.travadoManual ? '' : 'checked' %> onchange="toggleTravaManual()">
          <span class="slider"></span>
        </label>
        <span id="statusTravaTxt" style="font-size: 10px; font-weight: 600; color: <%= config.travadoManual ? '#ff453a' : '#34c759' %>;">
          <%= config.travadoManual ? 'TRAVADO' : 'LIBERADO' %>
        </span>
      </div>

      <div style="display: flex; gap: 8px;">
        <a href="/admin/exportar-csv" class="btn-header-action btn-export">📊 Excel</a>
        <a href="/admin/login" class="btn-header-action btn-logout">Sair</a>
      </div>
    </div>
  </header>

  <!-- Dashboard Grid -->
  <div class="dashboard-grid">
    <div class="stats-column">
      <div class="stat-card">
        <div class="stat-label">Total de Pedidos</div>
        <div class="stat-value" id="stat-total"><%= cadastrados.length %> / 400</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Envios Realizados</div>
        <div class="stat-value" id="stat-enviados" style="color: #34c759;">
          <%= cadastrados.filter(i => i.enviado).length %>
        </div>
      </div>
    </div>

    <div class="charts-column">
      <div class="chart-card">
        <div class="chart-title">Status</div>
        <div style="width: 90px; height: 90px; display: flex; align-items: center; justify-content: center;">
          <canvas id="statusChart"></canvas>
        </div>
      </div>
      <div class="chart-card">
        <div class="chart-title">Top Estados</div>
        <div style="width: 100%; height: 100px; display: flex; align-items: center; justify-content: center;">
          <canvas id="statesChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Timeline Recente -->
    <div class="timeline-card">
      <div class="chart-title" style="margin-bottom: 8px;">Atividades Recentes</div>
      <div id="timeline-feed">
        <div class="timeline-item">
          <span>Painel iniciado</span>
          <span class="timeline-time">Agora</span>
        </div>
        <% cadastrados.slice(0, 3).forEach(item => { %>
          <div class="timeline-item">
            <span>Pedido: <strong><%= item.nome %></strong></span>
            <span class="timeline-time"><%= item.cidade %> / <%= item.estado %></span>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <main>
    <div class="table-container">
      <div class="table-header-box">
        <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap; width: 100%;">
          <div class="segmented-control">
            <button class="btn-segment active" onclick="filtrarStatus('todos', this)">Todos</button>
            <button class="btn-segment" onclick="filtrarStatus('pendente', this)">Pendentes</button>
            <button class="btn-segment" onclick="filtrarStatus('enviado', this)">Enviados</button>
          </div>

          <!-- Ações em Massa -->
          <div id="bulkActionsBar" class="bulk-actions-bar">
            <span id="selectedCount" style="font-size: 11px; font-weight: 600; color: #0a84ff;">0 sel.</span>
            <button onclick="executarAcaoMassa('enviado')" class="btn-action" style="background:#34c759; color:#fff;">Enviar</button>
            <button onclick="executarAcaoMassa('pendente')" class="btn-action" style="background:#ff453a; color:#fff;">Pendente</button>
          </div>
        </div>

        <input type="text" id="searchInput" class="search-input" placeholder="🔍 Pesquisar nome, email..." onkeyup="filtrarTabela()">
      </div>
      
      <!-- Wrapper com Rolagem Vertical e Horizontal Suave -->
      <div class="table-responsive-wrapper">
        <table>
          <thead>
            <tr>
              <th style="width: 30px; text-align: center;"><input type="checkbox" id="selectAll" onchange="toggleSelectAll(this)"></th>
              <th style="text-align: center;">Status</th>
              <th>Data</th>
              <th>Nome</th>
              <th>Nasc.</th>
              <th>E-mail / Tel</th>
              <th>Endereço para Correios</th>
              <th>Cidade / UF</th>
              <th>CEP</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody id="tabela-cadastrados">
            <% cadastrados.forEach(item => { %>
              <tr id="linha-<%= item.id %>" class="item-linha" data-id="<%= item.id %>" data-status="<%= item.enviado ? 'enviado' : 'pendente' %>" data-search="<%= (item.nome + ' ' + item.email + ' ' + item.cidade + ' ' + item.estado).toLowerCase() %>">
                <td style="text-align: center;"><input type="checkbox" class="row-checkbox" value="<%= item.id %>" onchange="atualizarBarraMassa()"></td>
                <td style="text-align: center;">
                  <button onclick="toggleStatus('<%= item.id %>', this)" class="status-badge <%= item.enviado ? 'badge-enviado' : 'badge-pendente' %>">
                    <span class="led"></span>
                    <span><%= item.enviado ? 'Enviado' : 'Pendente' %></span>
                  </button>
                </td>
                <td style="font-size: 11px; color: #86868b;"><%= new Date(item.dataCadastro).toLocaleDateString('pt-BR') %></td>
                <td style="font-weight: 600; color: #fff;"><%= item.nome %></td>
                <td style="font-size: 11px; color: #86868b;"><%= item.nascimento %></td>
                <td>
                  <div style="font-size: 12px; color: #f5f5f7;"><%= item.email %></div>
                  <div style="font-size: 11px; color: #0a84ff; font-weight: 500;"><%= item.telefone %></div>
                </td>
                <td style="font-size: 12px;"><%= item.endereco %><% if(item.complemento){ %>, <%= item.complemento %><% } %> — B. <%= item.bairro %></td>
                <td style="font-size: 12px;" class="td-estado-uf"><%= item.cidade %> / <%= item.estado %></td>
                <td style="font-size: 12px; color: #86868b;"><%= item.cep %></td>
                <td>
                  <div class="action-btns">
                    <button class="btn-action btn-copy" onclick="copiarEndereco('<%= item.nome %>', '<%= item.endereco %>', '<%= item.complemento %>', '<%= item.bairro %>', '<%= item.cidade %>', '<%= item.estado %>', '<%= item.cep %>')">Copiar</button>
                    <button class="btn-action btn-edit" onclick='abrirModal(<%= JSON.stringify(item) %>)'>Editar</button>
                    <button class="btn-action btn-delete" onclick="excluirCadastro('<%= item.id %>')">Excluir</button>
                  </div>
                </td>
              </tr>
            <% }) %>
            <% if (cadastrados.length === 0) { %>
              <tr id="tr-vazio">
                <td colspan="10" style="text-align: center; padding: 24px; color: #86868b;">Nenhum cadastro realizado até o momento.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <!-- Modal de Edição -->
  <div id="modalEdicao" class="modal-overlay">
    <div class="modal-content">
      <div class="modal-title">Editar Cadastro</div>
      <form id="formEdicao" method="POST">
        <div class="form-group"><label>Nome Completo</label><input type="text" id="edit-nome" name="nome" required></div>
        <div class="form-group"><label>Data de Nascimento</label><input type="date" id="edit-nascimento" name="nascimento" required></div>
        <div class="form-group"><label>E-mail</label><input type="email" id="edit-email" name="email" required></div>
        <div class="form-group"><label>Telefone / WhatsApp</label><input type="text" id="edit-telefone" name="telefone" required></div>
        <div class="form-group"><label>País</label><select id="edit-pais" name="pais"><option value="Brasil">Brasil</option><option value="Outro">Outro</option></select></div>
        <div class="form-group"><label>CEP / ZIP</label><input type="text" id="edit-cep" name="cep" required></div>
        <div class="form-group"><label>Endereço</label><input type="text" id="edit-endereco" name="endereco" required></div>
        <div class="form-group"><label>Complemento</label><input type="text" id="edit-complemento" name="complemento"></div>
        <div class="form-group"><label>Bairro</label><input type="text" id="edit-bairro" name="bairro" required></div>
        <div class="form-group"><label>Cidade</label><input type="text" id="edit-cidade" name="cidade" required></div>
        <div class="form-group"><label>Estado / UF</label><input type="text" id="edit-estado" name="estado" required></div>
        <div class="modal-actions">
          <button type="submit" class="btn-save">Salvar</button>
          <button type="button" class="btn-cancel" onclick="fecharModal()">Cancelar</button>
        </div>
      </form>
    </div>
  </div>

  <footer>
    Chat Garage © 2026 — Criado e desenvolvido por 
    <a href="https://www.curriculodosergio.com.br/" target="_blank" rel="noopener noreferrer" class="dev-badge">Sergio Gil</a> 
    utilizando a tecnologia Node.js.
  </footer>

  <script>
    let filtroStatusAtual = 'todos';
    let statusChart, statesChart;
    
    function initCharts() {
      const linhas = document.querySelectorAll('.item-linha');
      let enviados = 0, pendentes = 0;
      let estadosMap = {};

      linhas.forEach(l => {
        const isEnviado = l.getAttribute('data-status') === 'enviado';
        if (isEnviado) enviados++; else pendentes++;
        const ufText = l.querySelector('.td-estado-uf').innerText;
        const uf = ufText.split('/')[1]?.trim().toUpperCase() || 'OUTROS';
        estadosMap[uf] = (estadosMap[uf] || 0) + 1;
      });

      const ctxStatus = document.getElementById('statusChart').getContext('2d');
      statusChart = new Chart(ctxStatus, {
        type: 'doughnut',
        data: { labels: ['Enviados', 'Pendentes'], datasets: [{ data: [enviados, pendentes], backgroundColor: ['#34c759', '#ff453a'], borderWidth: 0 }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
      });

      const sortedEstados = Object.entries(estadosMap).sort((a,b) => b[1] - a[1]).slice(0, 4);
      const ctxStates = document.getElementById('statesChart').getContext('2d');
      statesChart = new Chart(ctxStates, {
        type: 'bar',
        data: { labels: sortedEstados.map(e => e[0]), datasets: [{ data: sortedEstados.map(e => e[1]), backgroundColor: '#0a84ff', borderRadius: 6 }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { grid: { display: false }, ticks: { color: '#86868b', font: { size: 9 } } }, y: { grid: { color: 'rgba(255,255,255,0.04)' }, ticks: { color: '#86868b', font: { size: 9 }, stepSize: 1 } } } }
      });
    }

    window.addEventListener('DOMContentLoaded', initCharts);

    function mostrarToast(mensagem) {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = 'toast';
      toast.innerHTML = `✨ <span>${mensagem}</span>`;
      container.appendChild(toast);
      setTimeout(() => toast.remove(), 3000);
    }

    function toggleSelectAll(master) {
      const checkboxes = document.querySelectorAll('.row-checkbox');
      checkboxes.forEach(cb => cb.checked = master.checked);
      atualizarBarraMassa();
    }

    function atualizarBarraMassa() {
      const selecionados = document.querySelectorAll('.row-checkbox:checked');
      const bar = document.getElementById('bulkActionsBar');
      const count = document.getElementById('selectedCount');
      if (selecionados.length > 0) {
        bar.classList.add('visible');
        count.innerText = `${selecionados.length} sel.`;
      } else {
        bar.classList.remove('visible');
      }
    }

    async function executarAcaoMassa(acao) {
      const selecionados = Array.from(document.querySelectorAll('.row-checkbox:checked')).map(cb => cb.value);
      if (selecionados.length === 0) return;
      try {
        const res = await fetch('/admin/acao-massa', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids: selecionados, acao })
        });
        const data = await res.json();
        if (data.success) location.reload();
      } catch (err) { console.error(err); }
    }

    async function toggleTravaManual() {
      try {
        const response = await fetch('/admin/toggle-trava', { method: 'POST' });
        const data = await response.json();
        const txt = document.getElementById('statusTravaTxt');
        if (data.travadoManual) {
          txt.innerText = 'TRAVADO'; txt.style.color = '#ff453a';
          mostrarToast('Cadastros travados.');
        } else {
          txt.innerText = 'LIBERADO'; txt.style.color = '#34c759';
          mostrarToast('Cadastros liberados!');
        }
      } catch (err) { console.error(err); }
    }

    function copiarEndereco(nome, endereco, complemento, bairro, cidade, estado, cep) {
      const textoFormatado = `Destinatário: ${nome}\nEndereço: ${endereco}${complemento ? ', ' + complemento : ''}\nBairro: ${bairro}\nCidade: ${cidade} - ${estado}\nCEP: ${cep}`;
      navigator.clipboard.writeText(textoFormatado).then(() => {
        mostrarToast(`Endereço de ${nome} copiado!`);
      });
    }

    function filtrarStatus(status, btn) {
      filtroStatusAtual = status;
      document.querySelectorAll('.btn-segment').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      aplicarFiltros();
    }

    function filtrarTabela() { aplicarFiltros(); }

    function aplicarFiltros() {
      const termo = document.getElementById('searchInput').value.toLowerCase();
      const linhas = document.querySelectorAll('.item-linha');
      linhas.forEach(linha => {
        const statusItem = linha.getAttribute('data-status');
        const dados = linha.getAttribute('data-search');
        const matchStatus = (filtroStatusAtual === 'todos' || statusItem === filtroStatusAtual);
        const matchSearch = dados.includes(termo);
        linha.style.display = (matchStatus && matchSearch) ? '' : 'none';
      });
    }

    async function toggleStatus(id, btn) {
      try {
        const response = await fetch(`/admin/toggle-status/${id}`, { method: 'POST' });
        const data = await response.json();
        if (data.success) {
          const linha = document.getElementById(`linha-${id}`);
          const spanText = btn.querySelector('span:last-child');
          if (btn.classList.contains('badge-enviado')) {
            btn.classList.replace('badge-enviado', 'badge-pendente');
            spanText.innerText = 'Pendente';
            linha.setAttribute('data-status', 'pendente');
            mostrarToast('Marcado como Pendente.');
          } else {
            btn.classList.replace('badge-pendente', 'badge-enviado');
            spanText.innerText = 'Enviado';
            linha.setAttribute('data-status', 'enviado');
            mostrarToast('Marcado como Enviado!');
          }
          atualizarEstatisticasGraficos();
        }
      } catch (err) { console.error(err); }
    }

    async function excluirCadastro(id) {
      if (!confirm('Deseja excluir este cadastro?')) return;
      try {
        const response = await fetch(`/admin/excluir/${id}`, { method: 'POST' });
        const data = await response.json();
        if (data.success) {
          document.getElementById(`linha-${id}`).remove();
          const totalElem = document.getElementById('stat-total');
          let [atual, limite] = totalElem.innerText.split(' / ');
          totalElem.innerText = `${parseInt(atual) - 1} / ${limite}`;
          atualizarEstatisticasGraficos();
          mostrarToast('Cadastro excluído.');
        }
      } catch (err) { console.error(err); }
    }

    function atualizarEstatisticasGraficos() {
      const linhas = document.querySelectorAll('.item-linha');
      let enviados = 0, pendentes = 0;
      let estadosMap = {};

      linhas.forEach(l => {
        const isEnviado = l.getAttribute('data-status') === 'enviado';
        if (isEnviado) enviados++; else pendentes++;
        const ufText = l.querySelector('.td-estado-uf').innerText;
        const uf = ufText.split('/')[1]?.trim().toUpperCase() || 'OUTROS';
        estadosMap[uf] = (estadosMap[uf] || 0) + 1;
      });

      document.getElementById('stat-enviados').innerText = enviados;
      statusChart.data.datasets[0].data = [enviados, pendentes];
      statusChart.update();

      const sortedEstados = Object.entries(estadosMap).sort((a,b) => b[1] - a[1]).slice(0, 4);
      statesChart.data.labels = sortedEstados.map(e => e[0]);
      statesChart.data.datasets[0].data = sortedEstados.map(e => e[1]);
      statesChart.update();
    }

    function abrirModal(item) {
      document.getElementById('formEdicao').action = `/admin/editar/${item.id}`;
      document.getElementById('edit-nome').value = item.nome || '';
      document.getElementById('edit-nascimento').value = item.nascimento || '';
      document.getElementById('edit-email').value = item.email || '';
      document.getElementById('edit-telefone').value = item.telefone || '';
      document.getElementById('edit-pais').value = item.pais || 'Brasil';
      document.getElementById('edit-cep').value = item.cep || '';
      document.getElementById('edit-endereco').value = item.endereco || '';
      document.getElementById('edit-complemento').value = item.complemento || '';
      document.getElementById('edit-bairro').value = item.bairro || '';
      document.getElementById('edit-cidade').value = item.cidade || '';
      document.getElementById('edit-estado').value = item.estado || '';
      document.getElementById('modalEdicao').style.display = 'flex';
    }

    function fecharModal() { document.getElementById('modalEdicao').style.display = 'none'; }
  </script>
</body>
</html>