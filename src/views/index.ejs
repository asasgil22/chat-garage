<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Chat Garage - Promoção de Adesivos</title>
  <link rel="icon" href="/img/logo.jpg" type="image/jpeg">
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    body {
      background-color: #000000;
      color: #f5f5f7;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Segoe UI", Roboto, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow-x: hidden;
      background-image: radial-gradient(circle at 50% -20%, #1c1c1e 0%, #000000 70%);
    }
    
    .bg-garage-container { position: fixed; inset: 0; z-index: -1; }
    .bg-slide {
      position: absolute; inset: -10px; background-size: cover; background-position: center;
      filter: blur(8px); transform: scale(1.04); opacity: 0; transition: opacity 1.5s ease-in-out;
    }
    .bg-slide.active { opacity: 1; }
    .bg-garage-overlay { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.75); }

    /* Header Opção 3 com Linha Neon Fina */
    header {
      background: rgba(18, 18, 20, 0.85); 
      backdrop-filter: blur(30px); 
      -webkit-backdrop-filter: blur(30px);
      padding: 14px 24px;
      display: flex; 
      align-items: center; 
      justify-content: space-between; 
      position: relative; 
      z-index: 10;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }
    header::after {
      content: "";
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent 0%, rgba(245, 158, 11, 0.6) 50%, transparent 100%);
    }

    .brand-box { display: flex; align-items: center; gap: 12px; }
    .brand-logo { 
      width: 42px; 
      height: 42px; 
      border-radius: 50%; 
      border: 1.5px solid rgba(245, 158, 11, 0.6); 
      object-fit: cover; 
      box-shadow: 0 0 15px rgba(245, 158, 11, 0.25); 
    }
    .brand-title { color: #ffffff; font-weight: 700; text-transform: uppercase; font-size: 14px; letter-spacing: -0.3px; }
    .brand-sub { color: #86868b; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; }

    .minimal-tag {
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #86868b;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .minimal-tag span { color: #34c759; font-weight: 700; }

    /* Bullet verde piscando (pulso) */
    .status-dot {
      width: 6px;
      height: 6px;
      background: #34c759;
      border-radius: 50%;
      box-shadow: 0 0 8px #34c759;
      animation: pulse 1.8s infinite;
    }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

    .card-counter-box {
      background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(255, 255, 255, 0.08);
      padding: 14px 16px; border-radius: 14px; width: 100%; display: flex; flex-direction: column;
      align-items: center; margin-bottom: 20px; box-shadow: inset 0 1px 1px rgba(255,255,255,0.05);
    }
    .card-counter-top { font-size: 11px; text-transform: uppercase; color: #86868b; font-weight: 600; letter-spacing: 0.5px; margin-bottom: 2px; text-align: center; }
    .card-counter-value { font-size: 24px; font-weight: 700; color: #f59e0b; letter-spacing: -0.5px; }
    .card-progress-container { width: 100%; max-width: 220px; height: 6px; background-color: rgba(255,255,255,0.1); border-radius: 3px; margin-top: 8px; overflow: hidden; }
    .card-progress-fill { height: 100%; background: linear-gradient(90deg, #f59e0b, #ff453a); transition: width 0.4s cubic-bezier(0.25, 1, 0.5, 1); }

    main { flex: 1; display: flex; align-items: center; justify-content: center; padding: 24px 12px; position: relative; z-index: 10; }
    
    .form-card {
      background: rgba(28, 28, 30, 0.75); backdrop-filter: blur(30px); -webkit-backdrop-filter: blur(30px);
      border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 24px; width: 100%; max-width: 580px;
      padding: 28px 20px; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6); display: flex; flex-direction: column; align-items: center;
    }
    
    .form-header-logo {
      width: 84px; height: 84px; border-radius: 50%; border: 3px solid #f59e0b;
      object-fit: cover; margin-bottom: 14px; box-shadow: 0 0 25px rgba(245, 158, 11, 0.35);
    }
    .form-title { font-size: 20px; font-weight: 700; color: #ffffff; text-transform: uppercase; margin-bottom: 4px; text-align: center; letter-spacing: -0.3px; }
    .form-desc { font-size: 12px; color: #86868b; text-align: center; margin-bottom: 6px; }
    .form-obs { font-size: 11px; color: #f59e0b; text-align: center; margin-bottom: 16px; font-weight: 600; }

    form { width: 100%; }
    .field-group { margin-bottom: 14px; position: relative; }
    .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px; }
    .field-row-3 { display: grid; grid-template-columns: 2fr 1fr; gap: 12px; margin-bottom: 14px; }
    
    label { display: block; font-size: 11px; font-weight: 600; text-transform: uppercase; color: #86868b; margin-bottom: 6px; letter-spacing: 0.5px; }
    
    input, select {
      width: 100%; 
      background: rgba(0, 0, 0, 0.4); 
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px; 
      padding: 0 14px; 
      height: 48px;
      color: #ffffff; 
      font-size: 16px; 
      outline: none;
      -webkit-appearance: none; 
      appearance: none;
      box-sizing: border-box;
      transition: all 0.2s cubic-bezier(0.25, 1, 0.5, 1);
    }
    
    input[type="date"] { display: flex; align-items: center; }

    input:focus, select:focus { border-color: #0a84ff; box-shadow: 0 0 0 3px rgba(10, 132, 255, 0.2); }
    input.valid-glow { border-color: #34c759; box-shadow: 0 0 0 2px rgba(52, 199, 89, 0.15); }

    .cep-loading {
      position: absolute; right: 12px; top: 38px; width: 16px; height: 16px;
      border: 2px solid rgba(255,255,255,0.2); border-top-color: #0a84ff; border-radius: 50%;
      animation: spin 0.6s linear infinite; display: none;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .btn-submit {
      width: 100%; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: #000000;
      font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; padding: 14px; border: none;
      border-radius: 12px; font-size: 14px; cursor: pointer; margin-top: 6px;
      transition: all 0.2s cubic-bezier(0.25, 1, 0.5, 1); box-shadow: 0 4px 20px rgba(217, 119, 6, 0.3);
      display: flex; align-items: center; justify-content: center; gap: 8px;
    }
    .btn-submit:active { transform: scale(0.98); }
    .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; }

    .btn-spinner {
      width: 16px; height: 16px; border: 2px solid rgba(0,0,0,0.3); border-top-color: #000;
      border-radius: 50%; animation: spin 0.6s linear infinite; display: none;
    }

    .alert-box { width: 100%; background: rgba(255, 69, 58, 0.15); border: 1px solid rgba(255, 69, 58, 0.3); color: #ff453a; padding: 20px; border-radius: 16px; text-align: center; }

    /* Apple Wallet Digital Ticket Modal */
    .success-modal-overlay { display: <%= sucesso ? 'flex' : 'none' %>; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.82); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px); z-index: 1000; align-items: center; justify-content: center; padding: 16px; animation: fadeIn 0.3s cubic-bezier(0.25, 1, 0.5, 1); }
    .success-modal-card { background: rgba(28, 28, 30, 0.95); backdrop-filter: blur(30px); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 24px; width: 100%; max-width: 440px; padding: 28px 20px; text-align: center; box-shadow: 0 30px 60px rgba(0, 0, 0, 0.8); position: relative; }
    
    .wallet-pass {
      background: linear-gradient(135deg, #1c1c1e 0%, #2c2c2e 100%);
      border: 1px solid rgba(245, 158, 11, 0.4); border-radius: 16px; padding: 16px; margin-bottom: 16px;
      text-align: left; box-shadow: 0 10px 25px rgba(0,0,0,0.5); position: relative; overflow: hidden;
    }
    .wallet-pass::before {
      content: ""; position: absolute; top: 0; right: 0; width: 80px; height: 80px;
      background: radial-gradient(circle, rgba(245,158,11,0.2) 0%, transparent 70%); border-radius: 50%;
    }
    .pass-header { display: flex; justify-content: space-between; align-items: center; font-size: 10px; font-weight: 700; text-transform: uppercase; color: #86868b; letter-spacing: 1px; margin-bottom: 10px; }
    .pass-title { font-size: 15px; font-weight: 700; color: #ffffff; letter-spacing: -0.3px; margin-bottom: 4px; }
    .pass-badge { display: inline-flex; align-items: center; gap: 6px; background: rgba(52, 199, 89, 0.15); color: #34c759; padding: 3px 10px; border-radius: 12px; font-size: 10px; font-weight: 600; border: 1px solid rgba(52, 199, 89, 0.3); }

    /* Estilo Prime: Chat Container / Balão de Mensagem */
    .chat-container {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 20px;
      text-align: left;
    }

    .avatar-wrapper {
      position: relative;
      flex-shrink: 0;
    }

    .character-talk-img {
      width: 64px;
      height: 64px;
      border-radius: 14px;
      border: 2px solid rgba(245, 158, 11, 0.5);
      object-fit: cover;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.6);
      background: #1c1c1e;
    }

    .online-badge {
      position: absolute;
      bottom: -2px;
      right: -2px;
      width: 14px;
      height: 14px;
      background: #34c759;
      border: 2px solid #1c1c1e;
      border-radius: 50%;
      box-shadow: 0 0 8px #34c759;
    }

    .chat-bubble {
      flex: 1;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      border-top-left-radius: 4px;
      padding: 12px 14px;
      position: relative;
      box-shadow: inset 0 1px 2px rgba(0,0,0,0.3);
    }

    .chat-sender-name {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: #86868b;
      font-weight: 700;
      margin-bottom: 4px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .rotating-phrase {
      font-size: 11px; 
      font-weight: 700; 
      color: #f59e0b; 
      text-transform: uppercase;
      letter-spacing: 0.6px; 
      transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1); 
      opacity: 1; 
      transform: translateY(0);
      line-height: 1.4;
    }
    .rotating-phrase.fade-out { opacity: 0; transform: translateY(-4px); }
    
    .btn-close-modal { background: #f59e0b; color: #000; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; padding: 12px 20px; border-radius: 12px; border: none; cursor: pointer; font-size: 13px; width: 100%; box-shadow: 0 4px 15px rgba(245,158,11,0.3); }

    @keyframes fadeIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
    
    /* Footer Padronizado com o Header (Glassmorphism + Linha Neon Superior em Degradê) */
    footer { 
      background: rgba(18, 18, 20, 0.85); 
      backdrop-filter: blur(30px); 
      -webkit-backdrop-filter: blur(30px); 
      padding: 16px 24px; 
      font-size: 12px; 
      color: #86868b; 
      width: 100%; 
      position: relative; 
      z-index: 10; 
      display: flex; 
      align-items: center; 
      justify-content: space-between; 
      flex-wrap: wrap; 
      gap: 12px;
      box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.5);
    }
    footer::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent 0%, rgba(245, 158, 11, 0.6) 50%, transparent 100%);
    }

    .footer-left {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .footer-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .dev-badge {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.12);
      padding: 2px 10px;
      border-radius: 12px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.25s cubic-bezier(0.25, 1, 0.5, 1);
      display: inline-flex;
      align-items: center;
    }
    .dev-badge:hover {
      background: rgba(245, 158, 11, 0.15);
      border-color: rgba(245, 158, 11, 0.4);
      color: #f59e0b;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.2);
    }

    @media(max-width: 600px) {
      .field-row, .field-row-3 { grid-template-columns: 1fr; gap: 0; }
      .form-card { padding: 22px 16px; }
      header { padding: 12px 16px; }
      footer { justify-content: center; text-align: center; padding: 14px 16px; flex-direction: column; gap: 8px; }
    }
  </style>
</head>
<body>

  <div class="bg-garage-container">
    <div class="bg-slide active" style="background-image: url('/img/background1.jpg'), url('/img/background.jpg');"></div>
    <div class="bg-slide" style="background-image: url('/img/background2.jpg'), url('/img/background.jpg');"></div>
    <div class="bg-slide" style="background-image: url('/img/background3.jpg'), url('/img/background.jpg');"></div>
    <div class="bg-garage-overlay"></div>
  </div>

  <div id="successModal" class="success-modal-overlay">
    <div class="success-modal-card">
      <img src="/img/logo.jpg" alt="Logo" style="width: 56px; height: 56px; border-radius: 50%; border: 2px solid #f59e0b; object-fit: cover; margin: 0 auto 10px auto; box-shadow: 0 0 20px rgba(245,158,11,0.4);" onerror="this.style.display='none'">
      <div style="font-size: 17px; font-weight: 700; color: #ffffff; text-transform: uppercase; margin-bottom: 14px;">Inscrição Confirmada!</div>
      
      <div class="wallet-pass">
        <div class="pass-header">
          <span>CHAT GARAGE PASS</span>
          <span>#<%= total %> / 400</span>
        </div>
        <div class="pass-title">Adesivo Exclusivo Oficial</div>
        <div style="font-size: 11px; color: #86868b; margin-bottom: 8px;">Lote Limitado 2026</div>
        <div class="pass-badge">
          <span style="width: 6px; height: 6px; background: #34c759; border-radius: 50%;"></span>
          <span>Garantido e Reservado</span>
        </div>
      </div>

      <!-- Estrutura Prime Estilo Chat -->
      <div class="chat-container">
        <div class="avatar-wrapper">
          <img src="/img/animacao_anime_boca_ventriloquo.gif" alt="Personagem" class="character-talk-img" onerror="this.src='/img/logo.jpg'">
          <div class="online-badge"></div>
        </div>
        <div class="chat-bubble">
          <div class="chat-sender-name">
            <span>Garage Bot</span>
            <span style="font-size: 8px; color: #34c759;">● AO VIVO</span>
          </div>
          <div id="phraseElement" class="rotating-phrase">CALMA MEU PARCEIRO, SEU ADESIVO VAI CHEGAR NA MORAL!</div>
        </div>
      </div>

      <button type="button" class="btn-close-modal" onclick="fecharModalSucesso()">Entendido, valeu!</button>
    </div>
  </div>

  <!-- Header Padronizado -->
  <header>
    <div class="brand-box">
      <img src="/img/logo.jpg" alt="Logo" class="brand-logo" onerror="this.style.display='none'">
      <div>
        <div class="brand-title">Chat Garage</div>
        <div class="brand-sub">Edição Limitada</div>
      </div>
    </div>

    <div class="minimal-tag">
      <div class="status-dot"></div>
      Status: <span>Online</span>
    </div>
  </header>

  <main>
    <div class="form-card">
      
      <% if (lotado) { %>
        <div class="alert-box">
          <h2 style="font-size: 16px; margin-bottom: 8px;">🚨 CADASTROS INDISPONÍVEIS</h2>
          <p style="font-size: 12px; color: #86868b;">
            <% if (motivoBloqueio === 'manutencao') { %>
              O lote foi pausado manualmente pela administração.
            <% } else { %>
              O limite de 400 cadastros foi atingido!
            <% } %>
          </p>
        </div>
      <% } else { %>

        <img src="/img/logo.jpg" alt="Logo" class="form-header-logo" onerror="this.style.display='none'">

        <div class="form-title">Garanta seu Adesivo</div>
        <div class="form-desc">Preencha seus dados para garantir o envio gratuito.</div>
        <div class="form-obs">⚠️ Lote atual: 400 adesivos.</div>

        <div class="card-counter-box">
          <div class="card-counter-top">
            Pedidos Realizados 
            <span style="color: #34c759; font-weight: 700;">(<%= Math.round((total / limit) * 100) %>%)</span>
          </div>
          <div class="card-counter-value"><span id="contador-atual"><%= total %></span> / <%= limit %></div>
          <div class="card-progress-container">
            <% 
              let percentual = (total / limit) * 100;
              if (percentual > 100) percentual = 100;
            %>
            <div class="card-progress-fill" style="width: <%= percentual %>%;"></div>
          </div>
        </div>

        <form id="formCadastro" action="/cadastrar" method="POST" onsubmit="submeterFormulario(event)">
          
          <div class="field-group">
            <label>Nome Completo</label>
            <input type="text" name="nome" placeholder="Seu nome completo" required oninput="validarInput(this)">
          </div>

          <div class="field-group">
            <label>Data de Nascimento</label>
            <input type="date" name="nascimento" required oninput="validarInput(this)">
          </div>

          <div class="field-row">
            <div class="field-group">
              <label>E-Mail</label>
              <input type="email" name="email" placeholder="seu@email.com" required oninput="validarInput(this)">
            </div>
            <div class="field-group">
              <label>Telefone / WhatsApp</label>
              <input type="text" id="telefone" name="telefone" placeholder="(00) 00000-0000" required oninput="mascaraTelefone(this); validarInput(this)">
            </div>
          </div>

          <div class="field-row">
            <div class="field-group">
              <label>País</label>
              <select id="pais" name="pais" onchange="alternarPais()">
                <option value="Brasil" selected>🇧🇷 Brasil</option>
                <option value="Outro">🌍 Internacional</option>
              </select>
            </div>
            <div class="field-group">
              <label id="label-cep">CEP</label>
              <input type="text" id="cep" name="cep" placeholder="00000-000" maxlength="9" onblur="buscarCEP()" required oninput="mascaraCEP(this); validarInput(this)">
              <div id="cepLoader" class="cep-loading"></div>
            </div>
          </div>

          <div class="field-group">
            <label>Endereço (Rua, Número)</label>
            <input type="text" id="endereco" name="endereco" placeholder="Ex: Av. Brasil, 100" required oninput="validarInput(this)">
          </div>

          <div class="field-row">
            <div class="field-group">
              <label>Complemento <span style="font-weight:400; text-transform:lowercase; color:#86868b;">(opc.)</span></label>
              <input type="text" id="complemento" name="complemento" placeholder="Apto, Bloco...">
            </div>
            <div class="field-group">
              <label>Bairro</label>
              <input type="text" id="bairro" name="bairro" placeholder="Seu bairro" required oninput="validarInput(this)">
            </div>
          </div>

          <div class="field-row-3">
            <div class="field-group">
              <label>Cidade</label>
              <input type="text" id="cidade" name="cidade" placeholder="Sua cidade" required oninput="validarInput(this)">
            </div>
            <div class="field-group">
              <label id="label-estado">Estado / UF</label>
              <input type="text" id="estado" name="estado" maxlength="30" placeholder="RJ" required style="text-transform: uppercase;" oninput="validarInput(this)">
            </div>
          </div>

          <button type="submit" id="btnSubmit" class="btn-submit">
            <span id="btnSpinner" class="btn-spinner"></span>
            <span id="btnText">Garantir Meu Adesivo</span>
          </button>

        </form>
      <% } %>

    </div>
  </main>

  <!-- Footer Padronizado com o Header -->
  <footer>
    <div class="footer-left">
      <span>Chat Garage © 2026</span>
      <span style="color: rgba(255,255,255,0.2);">|</span>
      <span style="color: #86868b;">Edição Limitada</span>
    </div>
    
    <div class="footer-right">
      <span>Desenvolvido por</span>
      <a href="https://www.curriculodosergio.com.br/" target="_blank" rel="noopener noreferrer" class="dev-badge">Sergio Gil</a>
      <span style="font-size: 10px; color: #86868b;">via Node.js</span>
    </div>
  </footer>

  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('sucesso') === 'true') {
        confetti({ particleCount: 130, spread: 90, origin: { y: 0.6 } });
      }
    });

    let currentSlide = 0;
    const slides = document.querySelectorAll('.bg-slide');
    if (slides.length > 1) {
      setInterval(() => {
        slides[currentSlide].classList.remove('active');
        currentSlide = (currentSlide + 1) % slides.length;
        slides[currentSlide].classList.add('active');
      }, 6000);
    }

    const frasesSucesso = [
      "CALMA MEU PARCEIRO, SEU ADESIVO VAI CHEGAR NA MORAL!",
      "SE O TONIMEK NÃO ENVIAR PEDE PARA A ANGELICA!",
      "ESPERA AI 'MERMÃO', DEIXA DE SER VACILÃO, VAI CHEGAR!"
    ];
    let fraseIndex = 0;
    const phraseElement = document.getElementById('phraseElement');

    if (phraseElement) {
      setInterval(() => {
        phraseElement.classList.add('fade-out');
        setTimeout(() => {
          fraseIndex = (fraseIndex + 1) % frasesSucesso.length;
          phraseElement.innerText = frasesSucesso[fraseIndex];
          phraseElement.classList.remove('fade-out');
        }, 300);
      }, 3500);
    }

    function fecharModalSucesso() { window.location.href = '/'; }

    function mascaraCEP(input) {
      const pais = document.getElementById('pais').value;
      if (pais !== 'Brasil') return;
      let v = input.value.replace(/\D/g, '');
      if (v.length > 5) v = v.substring(0, 5) + '-' + v.substring(5, 8);
      input.value = v;
    }

    function mascaraTelefone(input) {
      let v = input.value.replace(/\D/g, '');
      if (v.length > 11) v = v.substring(0, 11);
      if (v.length > 6) {
        v = `(${v.substring(0, 2)}) ${v.substring(2, 7)}-${v.substring(7)}`;
      } else if (v.length > 2) {
        v = `(${v.substring(0, 2)}) ${v.substring(2)}`;
      } else if (v.length > 0) {
        v = `(${v}`;
      }
      input.value = v;
    }

    function validarInput(input) {
      if (input.value.trim().length > 0) {
        input.classList.add('valid-glow');
      } else {
        input.classList.remove('valid-glow');
      }
    }

    function submeterFormulario(e) {
      const btn = document.getElementById('btnSubmit');
      const text = document.getElementById('btnText');
      const spinner = document.getElementById('btnSpinner');
      btn.disabled = true;
      text.innerText = 'Processando...';
      spinner.style.display = 'inline-block';
    }

    function alternarPais() {
      const pais = document.getElementById('pais').value;
      const labelCep = document.getElementById('label-cep');
      const labelEstado = document.getElementById('label-estado');
      const inputCep = document.getElementById('cep');

      if (pais === 'Outro') {
        labelCep.innerText = 'ZIP / Postal Code';
        labelEstado.innerText = 'Estado / Província';
        inputCep.placeholder = 'ZIP Code';
        inputCep.removeAttribute('maxlength');
      } else {
        labelCep.innerText = 'CEP';
        labelEstado.innerText = 'Estado / UF';
        inputCep.placeholder = '00000-000';
        inputCep.setAttribute('maxlength', '9');
      }
    }

    async function buscarCEP() {
      const pais = document.getElementById('pais').value;
      if (pais !== 'Brasil') return;

      const cep = document.getElementById('cep').value.replace(/\D/g, '');
      const loader = document.getElementById('cepLoader');

      if (cep.length === 8) {
        loader.style.display = 'block';
        try {
          const res = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
          const data = await res.json();
          loader.style.display = 'none';
          if (!data.erro) {
            document.getElementById('endereco').value = data.logradouro || '';
            document.getElementById('bairro').value = data.bairro || '';
            document.getElementById('cidade').value = data.localidade || '';
            document.getElementById('estado').value = data.uf || '';
            
            ['endereco', 'bairro', 'cidade', 'estado'].forEach(id => {
              document.getElementById(id).classList.add('valid-glow');
            });
          }
        } catch (err) {
          loader.style.display = 'none';
          console.error('Erro no CEP', err);
        }
      }
    }
  </script>
</body>
</html>